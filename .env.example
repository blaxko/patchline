# Copy to .env and fill in real values. Never commit .env.

# --- AssemblyAI (server-side only; browser gets a short-lived temp token minted by the backend) ---
ASSEMBLYAI_API_KEY=

# --- Groq (chat completions for both agents + Orpheus TTS) ---
GROQ_API_KEY=

# --- Database ---
DATABASE_URL="file:./prisma/dev.db"

# --- Operator dashboard auth (no default shipped; server refuses to boot without these in non-dev mode) ---
OPERATOR_PASSWORD=
SESSION_SECRET=

# --- Audio storage / retention ---
AUDIO_STORAGE_DIR=./data/audio
AUDIO_RETENTION_DAYS=30

# --- Promotion gate ---
LATENCY_REGRESSION_THRESHOLD=1.25

# --- Test/CI toggles ---
MOCK_ASSEMBLYAI=1
RUN_LIVE_ASSEMBLYAI_TESTS=0

# --- Future/multi-tenant scaffolding (documented no-op in this build, see SECURITY.md) ---
REDACT_TRANSCRIPT_PII=0

# --- Ports (local dev) ---
WEB_PORT=3000
BACKEND_PORT=8080

# --- Frontend: where the browser reaches the backend (no secrets — this is bundle-visible) ---
NEXT_PUBLIC_BACKEND_HTTP_URL=http://localhost:8080
NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:8080/ws/session
