{
  "name": "patchline",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "clean:prisma": "node -e \"require('node:fs').rmSync('node_modules/.prisma', { recursive: true, force: true })\"",
    "pretypecheck": "pnpm run clean:prisma && pnpm run prisma:generate",
    "typecheck": "pnpm -r run typecheck",
    "pretest": "pnpm run clean:prisma && pnpm run prisma:generate",
    "test": "pnpm -r run test && vitest run --config vitest.root.config.ts",
    "test:regression": "vitest run --config vitest.root.config.ts tests/regression",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "ulid": "^2.3.0",
    "vitest": "^2.1.8"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
