// Patchline database schema.
// Step 2 adds the commerce sandbox tables only (customers, orders, products, tool_call_audit).
// Reliability tables (sessions, utterances, entities, ...) are added in later build steps per PRD.md §3/§9.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// --- Commerce sandbox (PRD.md §4, §9 Step 2) ---
// Sandbox-owned tables, distinct from the reliability tables added in later steps.

model Customer {
  id        String   @id
  name      String
  email     String
  phone     String
  createdAt DateTime @default(now()) @map("created_at")

  orders Order[]

  @@map("customers")
}

model Order {
  id             String   @id
  orderId        String   @unique @map("order_id")
  customerId     String   @map("customer_id")
  status         String // processing, shipped, out_for_delivery, delivered, delayed
  trackingId     String?  @map("tracking_id")
  total          Float
  refundEligible String   @map("refund_eligible") // full, partial, ineligible
  shippingAddress String  @map("shipping_address")
  placedAt       DateTime @map("placed_at")
  createdAt      DateTime @default(now()) @map("created_at")

  customer Customer    @relation(fields: [customerId], references: [id])
  items    OrderItem[]

  @@map("orders")
}

model Product {
  id    String @id
  sku   String @unique
  name  String
  price Float

  orderItems OrderItem[]

  @@map("products")
}

model OrderItem {
  id        String @id
  orderId   String @map("order_id")
  productId String @map("product_id")
  quantity  Int

  order   Order   @relation(fields: [orderId], references: [id])
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model ToolCallAudit {
  id          String   @id
  toolName    String   @map("tool_name")
  args        String // JSON string
  result      String // JSON string
  simulated   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("tool_call_audit")
}

// --- Reliability tables (PRD.md §3, added incrementally per §9 build step) ---

// Minimal Configuration Registry row, needed starting Step 3 so the AssemblyAI
// Adapter has an active config to read query params from. Full lifecycle
// (versioning, promotion gate, rollback) is implemented in Step 9.
model Config {
  id                            String    @id
  version                       Int
  name                          String
  speechModel                   String    @map("speech_model") // universal-3-5-pro | universal-streaming-english
  contextMode                   String    @map("context_mode") // none | prompt | keyterms
  prompt                        String?
  keytermsPrompt                String?   @map("keyterms_prompt") // JSON string[] or null
  agentContextEnabled           Boolean   @map("agent_context_enabled")
  previousContextNTurns         Int       @map("previous_context_n_turns")
  endOfTurnConfidenceThreshold  Float     @map("end_of_turn_confidence_threshold")
  formatTurns                   Boolean   @map("format_turns")
  notes                         String
  status                        String    @default("draft") // draft|tested|eligible|rejected|active|superseded
  promotedBy                    String?   @map("promoted_by")
  promotedAt                    DateTime? @map("promoted_at")
  createdAt                     DateTime  @default(now()) @map("created_at")

  sessions Session[]

  @@map("configs")
}

model Session {
  id              String    @id
  startedAt       DateTime  @default(now()) @map("started_at")
  endedAt         DateTime? @map("ended_at")
  status          String // connecting|active|reconnecting|degraded|completed|failed
  activeConfigId  String    @map("active_config_id")
  callerLabel     String    @map("caller_label")
  summary         String?
  mode            String // live_mic|prerecorded_clip

  activeConfig Config      @relation(fields: [activeConfigId], references: [id])
  utterances   Utterance[]
  entities     Entity[]

  @@map("sessions")
}

model Utterance {
  id                  String   @id
  sessionId           String   @map("session_id")
  speaker             String // caller|agent
  text                String
  startMs             Int      @map("start_ms")
  endMs               Int      @map("end_ms")
  turnOrder           Int      @map("turn_order")
  endOfTurnConfidence Float    @map("end_of_turn_confidence")
  createdAt           DateTime @default(now()) @map("created_at")

  session  Session  @relation(fields: [sessionId], references: [id])
  entities Entity[]

  @@map("utterances")
}

model Entity {
  id                  String    @id
  sessionId           String    @map("session_id")
  utteranceId         String    @map("utterance_id")
  entityType          String    @map("entity_type") // one of the 10 critical types, PRD.md §0
  rawText             String    @map("raw_text")
  normalizedValue     String    @map("normalized_value")
  verificationState   String    @default("unverified") @map("verification_state")
  // unverified|validating|verified|ambiguous|rejected|confirmed_by_caller|escalated
  verifiedValue       String?   @map("verified_value")
  verifiedBy          String?   @map("verified_by") // deterministic_validation|caller_confirmation|human_review
  startMs             Int       @map("start_ms")
  endMs               Int       @map("end_ms")
  createdAt           DateTime  @default(now()) @map("created_at")

  session   Session   @relation(fields: [sessionId], references: [id])
  utterance Utterance @relation(fields: [utteranceId], references: [id])

  @@map("entities")
}

model ToolCall {
  id           String    @id
  sessionId    String    @map("session_id")
  toolName     String    @map("tool_name")
  proposedArgs String    @map("proposed_args") // JSON string, exactly what the agent proposed
  finalArgs    String?   @map("final_args") // JSON string, set only if allowed
  gateResult   String    @map("gate_result") // allowed|blocked
  gateReason   String?   @map("gate_reason")
  // ENTITY_NOT_FOUND|ENTITY_AMBIGUOUS|MISSING_CONFIRMATION|VALUE_CONFLICT|LOW_EVIDENCE|POLICY_DENIED|null
  simulated    Boolean   @default(false)
  executedAt   DateTime? @map("executed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@map("tool_calls")
}

model ValidationResult {
  id            String   @id
  entityId      String   @map("entity_id")
  validatorName String   @map("validator_name") // e.g. order_id_existence, order_id_similarity
  result        String // match|no_match|ambiguous_candidates
  candidates    String? // JSON string, for ambiguous_candidates
  ranAt         DateTime @default(now()) @map("ran_at")

  @@map("validation_results")
}

model RepairEvent {
  id            String   @id
  sessionId     String   @map("session_id")
  entityId      String   @map("entity_id")
  question      String
  response      String?
  resolvedValue String?  @map("resolved_value")
  attemptNumber Int      @map("attempt_number")
  turnCount     Int      @map("turn_count")
  latencyMs     Int      @map("latency_ms")
  outcome       String // resolved|unresolved|escalated
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("repair_events")
}

model Regression {
  id               String   @id
  sourceSessionId  String   @map("source_session_id")
  entityId         String   @map("entity_id")
  entityType       String   @map("entity_type")
  expectedValue    String   @map("expected_value")
  observedValue    String   @map("observed_value")
  audioAsset       String   @map("audio_asset") // path under /data/audio
  audioStartMs     Int      @map("audio_start_ms")
  audioEndMs       Int      @map("audio_end_ms")
  contextBefore    String   @map("context_before")
  contextAfter     String   @map("context_after")
  baselineConfigId String   @map("baseline_config_id")
  repairMethod     String   @map("repair_method") // caller_confirmation|deterministic_validation|human_review — this IS truth_source
  status           String   @default("open") // open|replaying|replayed|closed|reopened
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("regressions")
}

model ReplayRun {
  id               String   @id
  regressionId     String   @map("regression_id")
  configId         String   @map("config_id")
  transcript       String
  extractedValue   String?  @map("extracted_value")
  exactMatch       Boolean  @map("exact_match")
  normalizedMatch  Boolean  @map("normalized_match")
  latencyMs        Int?     @map("latency_ms")
  transcriptDelta  String   @map("transcript_delta") // JSON string
  status           String // pass|fail
  ranAt            DateTime @default(now()) @map("ran_at")

  @@map("replay_runs")
}

model AuditEvent {
  id            String   @id
  eventType     String   @map("event_type")
  actor         String
  resourceType  String   @map("resource_type")
  resourceId    String   @map("resource_id")
  payload       String // JSON string
  correlationId String   @map("correlation_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("audit_events")
  @@index([correlationId])
}
