{
  "name": "backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && prisma generate --schema ../../prisma/schema.prisma",
    "start": "prisma migrate deploy --schema ../../prisma/schema.prisma && tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "lint": "echo \"(no lint configured yet)\""
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/websocket": "^11.0.2",
    "@prisma/client": "^5.22.0",
    "commerce-sandbox": "workspace:*",
    "evaluation": "workspace:*",
    "fastify": "^5.1.0",
    "schemas": "workspace:*",
    "ulid": "^2.3.0",
    "ws": "^8.18.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
